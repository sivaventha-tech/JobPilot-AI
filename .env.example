# ============================================================================
# JobPilot AI — Environment Configuration Template (.env.example)
# Copy this file to `.env.local` (frontend) and `backend/.env` (backend).
# NEVER commit actual API keys or credentials to version control.
# ============================================================================

# --- Frontend Configuration (Next.js Client-Side) ---
# Optional direct backend URL override (default empty string routes via Next.js server proxy /api/backend):
NEXT_PUBLIC_FASTAPI_URL=

# Optional future Supabase public project URL (never place service_role keys in frontend):
NEXT_PUBLIC_SUPABASE_URL=

# --- Next.js Server Proxy Configuration (Server-Side Only — NEVER prefix with NEXT_PUBLIC_) ---
# Target FastAPI backend URL for the server proxy:
FASTAPI_URL=http://localhost:8000

# Secret Bearer Token used by the Next.js server proxy to authenticate with FastAPI:
FASTAPI_API_KEY=your_secure_backend_auth_token_here

# --- Backend Configuration (Python FastAPI — Server-Side Only) ---
# API Protection & Bearer Token Authentication (Fails closed on sensitive routes when enabled)
JOBPILOT_REQUIRE_AUTH=false
JOBPILOT_API_AUTH_TOKEN=your_secure_backend_auth_token_here

# Rate Limiting & Payload Limits
JOBPILOT_RATE_LIMIT_ENABLED=true
JOBPILOT_RATE_LIMIT_RPM=60
JOBPILOT_EXPENSIVE_RATE_LIMIT_RPM=15
JOBPILOT_MAX_REQUEST_BYTES=15728640

# Vision & Structured Extraction AI Provider: "gemini" | "openai" | "none"
JOBPILOT_AI_PROVIDER=none

# Google Gemini API Key (server-side only, used when JOBPILOT_AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (server-side only, used when JOBPILOT_AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Web Search Research Provider: "duckduckgo" | "tavily" | "serper" | "brave" | "none"
# Set to "duckduckgo" for free public web research using `ddgs` without any API keys:
JOBPILOT_SEARCH_PROVIDER=duckduckgo

# Optional Commercial Search Provider API Keys (server-side only; not needed for duckduckgo)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Request Timeouts & Validation Limits
JOBPILOT_HTTP_TIMEOUT_SECONDS=10
JOBPILOT_MAX_IMAGE_BYTES=8388608
JOBPILOT_MAX_RESUME_BYTES=10485760
JOBPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex if preview deployments need access (leave blank/commented in strict production):
# JOBPILOT_CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# DuckDuckGo Search Reliability Safeguards (Bounded Retries + Backoff)
JOBPILOT_DDGS_MAX_RETRIES=1
JOBPILOT_DDGS_RETRY_BACKOFF_SECONDS=0.75

# Deterministic Explainable Job Match Weights (Sum normalized to 1.0)
JOBPILOT_MATCH_WEIGHT_SKILLS=0.55
JOBPILOT_MATCH_WEIGHT_EXPERIENCE=0.25
JOBPILOT_MATCH_WEIGHT_EDUCATION_CERTS=0.10
JOBPILOT_MATCH_WEIGHT_ROLE_LOCATION=0.10

# Safe Semi-Automatic Application Assistant & Playwright Browser Automation
# Keep false by default in production; set to true only on container environments with >= 2GB RAM
JOBPILOT_ENABLE_BROWSER_AUTOMATION=false
JOBPILOT_ASSIST_TIMEOUT_SECONDS=15.0

# Multi-Tenant SaaS Database & Cryptography Configuration
JOBPILOT_DB_PATH=backend/data/jobpilot.db
JOBPILOT_JWT_SECRET=your_jwt_signing_secret_here_replace_in_production
JOBPILOT_PBKDF2_ITERATIONS=100000

# Optional Stripe Commercial Billing & Webhook Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here


